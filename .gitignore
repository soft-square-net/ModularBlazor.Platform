/modules/client/Layouts.Admin/node-app/node_modules
*.json
# ...except the settings and npm manifests a fresh clone needs to build and run (no secrets in them: use user-secrets).
!/src/WebApi/WebApi/appsettings.json
!/src/WebApi/WebApi/appsettings.Development.json
!/src/apps/blazor/ModularBlazor.BlzWebClient/wwwroot/appsettings.json
# Launch profiles set ASPNETCORE_ENVIRONMENT=Development, which is what loads user secrets (the lab's passwords).
!**/Properties/launchSettings.json
!/modules/client/Layouts.Default/node-app/package.json
!/src/apps/blazor/ModularBlazor.BlzWebClient/node-app/package.json
# Translations (i18n/{culture}.json, embedded in each assembly): source files, never secrets.
!**/i18n/*.json
/modules/client/Layouts.Admin/node-app/package-lock.json
/modules/client/Layouts.Admin/node-app/yarn.lock

