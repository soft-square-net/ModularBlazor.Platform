@inherits LayoutComponentBase
@attribute [LayoutKey("admin")]
@implements IDisposable
@inject ICurrentUserService Users
@inject IAuthenticationService Auth
@inject IStringLocalizer<AdminLayout> L

@*
  The administration shell (layout key "admin"): a top bar with the admin areas. Module.Admin's pages use it; the
  host's own admin pages (client and host modules) and Module.Tenants keep the default layout and are linked here.
  Colours come from the --mud-palette-* tokens of Layouts.Default (MudTail), styles from css/module.css.
*@

<div class="adm-shell">
  <header class="adm-topbar">
    <a class="adm-brand" href="admin">@L["Administration"]</a>
    <nav class="adm-nav">
      <NavLink href="admin" Match="NavLinkMatch.All">@L["Overview"]</NavLink>
      <NavLink href="admin/members">@L["Members"]</NavLink>
      <NavLink href="tenants">@L["Tenants"]</NavLink>
      <NavLink href="client-modules">@L["Client modules"]</NavLink>
      <NavLink href="host-modules">@L["Host modules"]</NavLink>
    </nav>
    <div class="adm-user">
      @if (_user is not null)
      {
        <span>@_user.Name</span>
        <a href="login" @onclick="SignOutAsync" @onclick:preventDefault>@L["Sign out"]</a>
      }
      <LocaleSwitcher />
      <a href="">@L["← Back to the app"]</a>
    </div>
  </header>

  <main class="adm-main">@Body</main>
</div>

@code {
  private UserInfo? _user;

  protected override async Task OnInitializedAsync()
  {
    Users.Changed += OnChanged;
    _user = await Users.GetUserInfoAsync();
  }

  // Never block on the async user lookup (.Result freezes WebAssembly): hop onto the renderer and await it there.
  private void OnChanged() => _ = InvokeAsync(async () =>
  {
    _user = await Users.GetUserInfoAsync();
    StateHasChanged();
  });

  private Task SignOutAsync() => Auth.LogoutAsync();

  public void Dispose() => Users.Changed -= OnChanged;
}
