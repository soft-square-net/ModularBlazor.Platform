@inherits LayoutComponentBase
@attribute [LayoutKey("default")]
@implements IDisposable
@inject IModuleNavigation Navigation
@inject ICurrentUserService Users
@inject IAuthenticationService Auth
@inject IStringLocalizer<DefaultLayout> L

<div class="shell-default">
  <aside class="shell-sidebar">
    <a class="brand" href="">Modular Blazor</a>

    @* The three menus the modules fill (MenuLink / MenuGroup): main, secondary under it, user next to the account. *@
    <nav class="shell-nav" aria-label="@L["Main"]">
      <NavLink href="" Match="NavLinkMatch.All">@L["Home"]</NavLink>
      <MenuZone Zone="@MenuZones.Main" Landmark="false" />
    </nav>

    <MenuZone Zone="@MenuZones.Secondary" Class="shell-secondary" Label="@L["More"]" />

    <LocaleSwitcher Class="shell-locale" />

    <div class="shell-user">
      @if (_user is not null)
      {
        <div>@_user.Name <small>(@string.Join(", ", _user.Roles))</small></div>
        <MenuZone Zone="@MenuZones.User" Class="shell-user-menu" Label="@L["Account"]" />
        <a href="login" @onclick="SignOutAsync" @onclick:preventDefault>@L["Sign out"]</a>
      }
      else
      {
        <a href="login">@L["Sign in"]</a>
      }
    </div>
  </aside>

  <main class="shell-main">@Body</main>
</div>

@code {
  private UserInfo? _user;

  protected override async Task OnInitializedAsync()
  {
    Navigation.Changed += OnChanged;
    Users.Changed += OnChanged;
    _user = await Users.GetUserInfoAsync();
  }

  // Never block on the async user lookup (.Result freezes WebAssembly): hop onto the renderer and await it there.
  private void OnChanged() => _ = InvokeAsync(async () =>
  {
    _user = await Users.GetUserInfoAsync();
    StateHasChanged();
  });

  private Task SignOutAsync() => Auth.LogoutAsync(); // clears the session and goes to the login page

  public void Dispose()
  {
    Navigation.Changed -= OnChanged;
    Users.Changed -= OnChanged;
  }
}
