<Project Sdk="Microsoft.NET.Sdk">

  <!-- Published as a NuGet package: modules developed outside this repo compile against it. -->
  <Import Project="../../build/Platform.Packaging.props" />
  <PropertyGroup>
    <Description>ModularBlazor: types shared by the platform, its Blazor clients and modules.</Description>
  </PropertyGroup>
  <PropertyGroup>
    <AssemblyName>$(SoftSquarePrefix).Share.All</AssemblyName>
    <RootNamespace>$(SoftSquarePrefix).Share.All</RootNamespace>
  </PropertyGroup>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <!-- IStringLocalizer: part of ASP.NET Core on the server; a package in Blazor WebAssembly. -->
    <PackageReference Include="Microsoft.Extensions.Localization.Abstractions" Version="10.0.*" />
  </ItemGroup>

</Project>
