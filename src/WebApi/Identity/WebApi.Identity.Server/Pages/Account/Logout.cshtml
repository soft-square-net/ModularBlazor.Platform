@page
@model LogoutModel
@{ ViewData["Title"] = L["Sign out"].Value; }
<p class="mud-typography mud-typography-body2 id-muted">@L["Sign out of the identity service? Applications keep their tokens until they expire, but cannot get new ones silently."]</p>
<form method="post" class="id-stack">
    <button type="submit" class="mud-button-root mud-button-filled mud-button-primary mud-button-large id-block">@L["Sign out"]</button>
</form>
