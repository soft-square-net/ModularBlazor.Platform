            ],
            "additionalProperties": {
              "type": "string"
            }
          },
          "icon": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "ProblemDetails": {
        "type": "object",
        "properties": {
          "type": {
            "type": [
              "null",
