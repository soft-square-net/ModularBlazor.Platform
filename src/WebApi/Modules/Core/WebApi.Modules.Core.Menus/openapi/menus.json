            ]
          }
        }
      },
      "SaveMenuCustomization": {
        "required": [
          "version",
          "overrides",
          "items"
        ],
        "type": "object",
        "properties": {
          "version": {
            "type": "integer",
            "format": "int32"
          },
          "overrides": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/MenuOverride"
            }
          },
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/MenuCustomItem"
            }
          }
        }
      }
    },
    "securitySchemes": {
      "OAuth2": {
        "type": "oauth2",
        "flows": {
          "authorizationCode": {
            "authorizationUrl": "http://localhost:5090/connect/authorize",
            "tokenUrl": "http://localhost:5090/connect/token",
            "scopes": {
              "openid": "User identity",
              "profile": "User profile",
              "email": "User email",
              "api": "Access to Modular WebApi",
              "offline_access": "Refresh token"
            }
          }
        }
      }
    }
  },
  "security": [
    {
      "OAuth2": [
        "openid",
