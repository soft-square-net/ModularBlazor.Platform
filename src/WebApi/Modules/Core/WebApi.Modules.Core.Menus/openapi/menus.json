{
  "openapi": "3.1.1",
  "info": {
    "title": "Menus",
    "description": "Core module: administrators' changes to the client's menus (hide, rename, move, reorder; added and external links), per platform and per tenant.",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "/"
    }
  ],
  "paths": {
    "/api/menus": {
      "get": {
        "tags": [
          "Menus"
        ],
        "summary": "The administrators' changes to the menus for the caller's tenant (the platform's, then the tenant's) and the links they added that the caller may see. Sends an ETag; If-None-Match answers 304 when nothing changed.",
        "operationId": "Menus_Get",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EffectiveMenus"
                }
              }
            }
          },
          "304": {
            "description": "Not Modified"
          }
        }
      }
    },
    "/api/menus/admin": {
      "get": {
        "tags": [
          "Menus"
        ],
        "summary": "The layer this request changes, with what it is applied on: the tenant's (send the tenant) on top of the platform's, or the platform's (no tenant; platform.modules.manage).",
        "operationId": "Menus_GetLayer",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MenuAdminView"
                }
              }
            }
          },
          "403": {
            "description": "Forbidden",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      },
      "put": {
        "tags": [
          "Menus"
        ],
        "summary": "Replaces the layer (send the version it was read at). Ids of added items are local to the layer: the menu knows them as @platform:{id} or @tenant:{id}.",
        "operationId": "Menus_Save",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SaveMenuCustomization"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MenuAdminView"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "403": {
            "description": "Forbidden",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "409": {
            "description": "Conflict",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "EffectiveMenus": {
        "required": [
          "eTag",
          "overrides",
          "items",
          "canManage"
        ],
        "type": "object",
        "properties": {
          "eTag": {
            "type": "string"
          },
          "overrides": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/MenuOverride"
            }
          },
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/MenuEntry"
            }
          },
          "canManage": {
            "type": "boolean"
          }
        }
      },
      "MenuAdminView": {
        "required": [
          "scope",
          "customization",
          "inherited"
        ],
        "type": "object",
        "properties": {
          "scope": {
            "type": "string"
          },
          "customization": {
            "$ref": "#/components/schemas/MenuCustomization"
          },
          "inherited": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/MenuCustomization"
              }
            ]
          }
        }
      },
      "MenuCustomItem": {
        "required": [
          "id",
          "kind",
          "zone",
          "title"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "kind": {
            "type": "string"
          },
          "zone": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "titles": {
            "type": [
              "null",
              "object"
            ],
            "additionalProperties": {
              "type": "string"
            }
          },
          "href": {
            "type": [
              "null",
              "string"
            ]
          },
          "parent": {
            "type": [
              "null",
              "string"
            ]
          },
          "icon": {
            "type": [
              "null",
              "string"
            ]
          },
          "order": {
            "type": "integer",
            "format": "int32",
            "default": 100
          },
          "audience": {
            "type": "string",
            "default": "everyone"
          }
        }
      },
      "MenuCustomization": {
        "type": "object",
        "properties": {
          "version": {
            "type": "integer",
            "format": "int32"
          },
          "overrides": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/MenuOverride"
            }
          },
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/MenuCustomItem"
            }
          },
          "updatedAt": {
            "type": [
              "null",
              "string"
            ],
            "format": "date-time"
          },
          "updatedBy": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "MenuEntry": {
        "required": [
          "id",
          "kind",
          "zone",
          "title",
          "titles",
          "href",
          "parent",
          "icon",
          "order",
          "external"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "kind": {
            "type": "string"
          },
          "zone": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "titles": {
            "type": [
              "null",
              "object"
            ],
            "additionalProperties": {
              "type": "string"
            }
          },
          "href": {
            "type": [
              "null",
              "string"
            ]
          },
          "parent": {
            "type": [
              "null",
              "string"
            ]
          },
          "icon": {
            "type": [
              "null",
              "string"
            ]
          },
          "order": {
            "type": "integer",
            "format": "int32"
          },
          "external": {
            "type": "boolean"
          }
        }
      },
      "MenuOverride": {
        "required": [
