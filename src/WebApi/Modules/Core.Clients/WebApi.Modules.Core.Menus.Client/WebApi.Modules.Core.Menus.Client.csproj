<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Typed C# client for the Menus core module's HTTP API (the combined menu changes, and the admin API of a layer),
    generated by NSwag from the module's saved OpenAPI document
    (../../Core/WebApi.Modules.Core.Menus/openapi/menus.json, written by
    src/WebApi/scripts/Export-ModuleOpenApi.ps1 -CoreModuleId menus -Output <that path>).

    It lives in Modules/Core.Clients, not next to the module in Modules/Core: the WebApi build treats every
    Modules/Core/*/*.csproj as a core module and would ship this project as one.

    - Versioned with the module: change an endpoint, re-export the document, build; the client follows.
    - No runtime dependencies beyond the BCL (HttpClient, System.Text.Json), so the Blazor client app (or a client
      module) can reference it.
    - Not a server project: it references nothing from the WebApi and runs in the browser.
  -->

  <PropertyGroup>
    <ModuleOpenApiDocument>$(MSBuildProjectDirectory)/../../Core/WebApi.Modules.Core.Menus/openapi/menus.json</ModuleOpenApiDocument>
    <GeneratedClient>$(MSBuildProjectDirectory)/Generated/MenusClient.g.cs</GeneratedClient>
    <!-- When the file already exists, the default Compile glob picks it up; otherwise the target adds it after generating. -->
    <GeneratedClientExisted>$([System.IO.File]::Exists('$(GeneratedClient)'))</GeneratedClientExisted>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="NSwag.MSBuild" Version="14.8.0" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <None Include="nswag.json;$(ModuleOpenApiDocument)" />
  </ItemGroup>

  <!-- Regenerates the client only when the document or the settings changed (incremental: Inputs/Outputs). The output
       is committed, so the client builds without running NSwag and API changes show up in code review. -->
  <Target Name="GenerateMenusClient" BeforeTargets="BeforeBuild;CoreCompile"
          Inputs="$(ModuleOpenApiDocument);$(MSBuildProjectDirectory)/nswag.json" Outputs="$(GeneratedClient)">
    <Exec Command="$(NSwagExe_Net100) run nswag.json /variables:Document=&quot;$(ModuleOpenApiDocument)&quot;,Output=&quot;$(GeneratedClient)&quot;"
          WorkingDirectory="$(MSBuildProjectDirectory)" ConsoleToMSBuild="true" />
    <ItemGroup Condition="'$(GeneratedClientExisted)' != 'True'">
      <Compile Include="$(GeneratedClient)" />
    </ItemGroup>
  </Target>

</Project>
