@using System.Reflection
@using soft.square.net.ModularBlazor.Abstractions.Auth
@inject ModuleManager Modules
@inject ActiveModuleService Active
@inject ICurrentUserService CurrentUsers
@inject NavigationManager Nav
@inject IStringLocalizer<App> L

@if (_redirecting)
{
    <!-- navigating to the login page -->
}
else if (_forbidden)
{
    <LayoutView Layout="_layout">
        <PageTitle>@L["Access denied"]</PageTitle>
        <h1>@L["Access denied"]</h1>
        <p>@L["Your account does not have access to this module."]</p>
    </LayoutView>
}
else if (_ready)
{
    <LayoutView Layout="_layout">
        <DynamicComponent Type="RouteData.PageType" Parameters="_parameters" />
    </LayoutView>
}

@code {
    [Parameter, EditorRequired] public RouteData RouteData { get; set; } = default!;

    private Type? _layout;
    private IDictionary<string, object?>? _parameters;
    private bool _redirecting;
    private bool _forbidden;
    private bool _ready;

    protected override async Task OnParametersSetAsync()
    {
        _ready = _redirecting = _forbidden = false;

        var pageType = RouteData.PageType;
        var owner = Modules.GetOwner(pageType.Assembly);
        var user = await CurrentUsers.GetUserInfoAsync();

        // Modules can be loaded for the whole session, so a page can outlive the user's access to it.
        // Check on every navigation rather than trusting that the catalog was cleared.
        _redirecting = owner is { RequiresAuth: true } && user is null;
        if (_redirecting)
        {
            var returnUrl = Uri.EscapeDataString(ModuleManager.NormalizePath(Nav.ToBaseRelativePath(Nav.Uri)));
            Nav.NavigateTo($"login?returnUrl={returnUrl}", replace: true);
            return;
        }

        // The role comes from the token's "role" claims (UserInfo.Roles).
        _forbidden = owner?.RequiredRole is { } role && !(user?.IsInRole(role) ?? false);

        // Layout precedence: @layout on the page > [UseLayout] on the page > module's layout > default. A layout key no
        // loaded module registered loads the module that provides it first (Layouts.Public for "public", say); its
        // styles are applied before the page renders.
        _layout = pageType.GetCustomAttribute<LayoutAttribute>()?.LayoutType;
        if (_layout is null)
        {
            var key = pageType.GetCustomAttribute<UseLayoutAttribute>()?.Key ?? owner?.Layout;
            await Modules.EnsureLayoutAsync(key);
            _layout = Modules.ResolveLayout(key);
        }
        await Active.UseLayoutAsync(Modules.LayoutModule(_layout));

        _parameters = RouteData.RouteValues.ToDictionary(kv => kv.Key, kv => kv.Value);
        _ready = true;
    }
}
